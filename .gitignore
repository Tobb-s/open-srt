# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Corpus de E0: el audio se regenera con `npm run corpus:build`, no se versiona.
# El manifiesto SÍ va a git: es lo que hace comparables dos corridas.
/.corpus-src/
/public/corpus/*.wav

# Clips sueltos para auditorías puntuales: se copian a mano, no se versionan.
/public/audit/

.vercel
.env*

# Modelo del detector de voz: se descarga con `npm run vad:fetch`, no se versiona.
/.vad-tmp/

# El runtime de ONNX se copia desde node_modules antes de cada build (`prebuild`).
# 31 MB que no tiene sentido versionar: salen del paquete instalado, no de acá.
/public/ort/


# Restos de importar el script de mutacion desde Python.
__pycache__/
