{
  "name": "proyecto-transcripcion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutation": "python scripts/mutation-check.py",
    "corpus:build": "node scripts/build-corpus.mjs",
    "corpus:verify": "node scripts/verify-corpus.mjs",
    "vad:fetch": "node -e \"const fs=require('fs');fs.mkdirSync('.vad-tmp',{recursive:true});fetch('https://huggingface.co/onnx-community/silero-vad/resolve/main/onnx/model.onnx').then(r=>r.arrayBuffer()).then(b=>{fs.writeFileSync('.vad-tmp/silero_vad.onnx',Buffer.from(b));console.log('ok',(b.byteLength/1024).toFixed(0),'KB')})\"",
    "drift:build": "node scripts/build-drift-audio.mjs",
    "ort:vendor": "node scripts/vendor-ort.mjs",
    "prebuild": "node scripts/vendor-ort.mjs",
    "predev": "node scripts/vendor-ort.mjs",
    "pretest": "node scripts/vendor-ort.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.7.6",
    "docx": "^9.7.1",
    "next": "16.3.1",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@webgpu/types": "^0.1.72",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
